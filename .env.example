# Copy this file to .env and fill in your own local values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
COOKIE_SECURE=false

# MySQL settings (the app accepts both MYSQL_* and legacy DB_* names).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_DATABASE=AI_Maintenance_DB

# Optional MongoDB settings used by the AI decision engine and database browser.
# For local MongoDB, these defaults work when the service runs on this computer.
# The app accepts both MONGODB_* and legacy MONGO_* variable names.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=AI_Maintenance_Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=AI_Maintenance_Mongo
MONGO_COLLECTION=AI_Event_Log

# Optional bearing mapping: set only after confirming which one machine
# the NASA IMS dataset represents. Leave blank to skip bearing decisions safely.
NASA_IMS_MACHINE_ID=

# Optional: local SQLite file for manager accounts
# AUTH_DB_PATH=instance/auth.db
