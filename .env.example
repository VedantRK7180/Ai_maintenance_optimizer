# Copy this file to .env and fill in your own local values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
COOKIE_SECURE=false

# MySQL settings (the app accepts both MYSQL_* and legacy DB_* names).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-local-mysql-password
MYSQL_DATABASE=AI_Maintenance_DB

# Optional MongoDB settings used by the AI decision engine.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=AI_Maintenance_Mongo
MONGO_COLLECTION=AI_Event_Log

# Optional: local SQLite file for manager accounts
# AUTH_DB_PATH=instance/auth.db
