# Copy this file to .env and fill in your own local values.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
COOKIE_SECURE=false

# Existing MySQL machine/sensor database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=AI_Maintenance_DB

# Optional: override the robot training dataset folder when retraining
# ROBOT_DATA_FOLDER=/absolute/path/to/robot/training_data

# MongoDB used by AI decisions and what-if logging
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=AI_Maintenance_Mongo
MONGO_COLLECTION=AI_Event_Log
WHAT_IF_MONGO_COLLECTION=WHAT_IF_SCENARIOS

# Optional: local SQLite file for manager accounts
# AUTH_DB_PATH=instance/auth.db
